# Copied to /etc/norochan/norochan.env by setup.sh (owner root, mode 600).
# Placeholders only. Put real values in the server copy, never in git.

HOST=127.0.0.1
PORT=3000
HSTS=1
DATA_FILE=/var/lib/norochan/data.json
REWARDS_FILE=/var/lib/norochan/rewards.json

STAKE_TOKEN=replace-me
# STAKE_API_BASE=https://api.stake.com/affiliate

KICK_CHANNEL_USERNAME=norochan

# Official public JSON API. No key.
BOTRIX_PUBLIC=1
BOTRIX_PUBLIC_URL=https://botrix.live/api/public/leaderboard?platform=kick&user=norochan
BOTRIX_WATCHTIME_UNIT=minutes
BOTRIX_PLATFORM=kick
BOTRIX_CHANNEL=norochan
BOTRIX_TOP=10
BOTRIX_SYNC_MS=900000
# Optional issued JSON endpoint (used instead of the public API if set).
# BOTRIX_LEADERBOARD_URL=https://replace-me
# BOTRIX_API_KEY=replace-me
