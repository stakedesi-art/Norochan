# Copy the values you need into your host's environment settings (or your shell).
# Never commit real values. The server reads process.env only.

# --- Stake affiliate ---
STAKE_TOKEN=your-stake-affiliate-token
STAKE_API_BASE=https://api.stake.jp/affiliate
ALL_CAMPAIGNS=1
# Comma-separated Stake usernames that cannot win the monthly wheel (house account).
WHEEL_EXCLUDE=YASH001KG

# --- Server ---
PORT=3000
HOST=127.0.0.1
# Send Strict-Transport-Security once the site is served over HTTPS.
HSTS=0

# --- Data files (keep these outside the code folder on a server) ---
# DATA_FILE=src/data.json
# REWARDS_FILE=src/data/rewards.json

# --- Kick live status (public channel API; no OAuth) ---
KICK_CHANNEL_USERNAME=norochan

# --- BotRix Top viewers ---
# Official public JSON API. No key. Server-side only; never called from the browser.
BOTRIX_PUBLIC=1
BOTRIX_PLATFORM=kick
BOTRIX_CHANNEL=norochan
BOTRIX_TOP=10
BOTRIX_SYNC_MS=900000
BOTRIX_PUBLIC_URL=https://botrix.live/api/public/leaderboard?platform=kick&user=norochan
# Unit BotRix uses for numeric watch time: seconds, minutes or hours.
BOTRIX_WATCHTIME_UNIT=minutes
# Optional issued JSON endpoint. If set, this is used instead of BOTRIX_PUBLIC_URL.
# BOTRIX_LEADERBOARD_URL=https://endpoint-provided-by-botrix/{platform}/{channel}
# BOTRIX_API_KEY=your-botrix-api-key
# BOTRIX_API_KEY_HEADER=Authorization

# --- Staff studio (not linked from the public site) ---
# Long shared password. The studio cookie is HttpOnly, SameSite=Strict, Path=/api/admin.
# ADMIN_PASSWORD=
# Set to 1 only if a reverse proxy (nginx/ALB) sets X-Forwarded-For. Otherwise leave unset.
# TRUST_PROXY=0
# Send Strict-Transport-Security and Secure cookies once HTTPS is on.
# HSTS=1

# --- Monthly wheel Discord post ---
# Channel webhook (Server Settings → Integrations → Webhooks). The site records the
# full 3-winner spin at UTC month end and posts that video here. Never commit this URL.
# DISCORD_WHEEL_WEBHOOK=https://discord.com/api/webhooks/ID/TOKEN
# PUBLIC_SITE_URL=https://norochan.com
# BASE_URL=https://norochan.com

# --- Visitor login (Phase 3) ---
# Email + password. Confirmation links go through Gmail SMTP (app password).
# AUTH_TEST=1 skips SMTP and returns the confirm path in JSON — local tests only.
# AUTH_TEST=1
# GMAIL_USER=yourgmail@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
# OWNER_CODES=norochan,divu,ipl2026,deepu
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://norochan.com/auth/google/callback
# Local Kick connect: register BOTH redirect URLs in the Kick developer app.
# KICK_REDIRECT_URI=https://norochan.com/auth/kick/callback
# KICK_REDIRECT_URI=http://localhost:3200/auth/kick/callback
